# ============================================
# AI Voice Agent - Environment Variables Template
# ============================================

# Telnyx Credentials
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
TELNYX_ASSISTANT_ID=

# Telnyx Phone Number (the number assigned to your Connection)
TELNYX_PHONE_NUMBER=

# Public key from Telnyx Mission Control Portal -> API Keys
TELNYX_PUBLIC_KEY=

# Default number to call when request body omits to_number (optional)
YOUR_PHONE_NUMBER=

# Protect paid operations and assistant outcome callbacks.
# Generate with: openssl rand -hex 32
CALL_API_KEY=

# Private stable ntfy topic subscribed by the Discord bridge.
NTFY_TOPIC=

# Stable public HTTPS origin that routes to this service. Do not include a
# trailing slash. Telnyx webhooks will use PUBLIC_URL/call-events.
PUBLIC_URL=https://voice.example.com

# Optional named Cloudflare Tunnel. Configure its public hostname to route to
# http://ai-voice-agent:8000, then start Compose with the tunnel profile.
CLOUDFLARE_TUNNEL_TOKEN=

# Server Configuration
HOST=0.0.0.0
PORT=8000
APP_BIND_ADDRESS=127.0.0.1
APP_PUBLIC_PORT=48611
WEBHOOK_TOLERANCE_SECONDS=300
CALL_DATABASE_PATH=/app/data/calls.sqlite3
RECORDING_DIRECTORY=/app/data/recordings
PERSONAL_KNOWLEDGE_PATH=/app/config/personal-knowledge.md
SENSITIVE_KNOWLEDGE_PATH=/app/config/sensitive-knowledge.md
CALL_RETENTION_DAYS=30

# Voice IDs from the Telnyx voice catalog. The Spanish default is a Castilian
# Ultra voice selected for natural conversation.
TELNYX_SPANISH_VOICE=Telnyx.Ultra.58e531e3-b212-49df-adee-c335a19c2429
TELNYX_ENGLISH_VOICE=Telnyx.KokoroTTS.am_michael
